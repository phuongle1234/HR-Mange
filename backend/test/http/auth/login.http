@baseUrl = http://localhost:3000/api

### Login - success
# Seed credentials from prisma/seed.ts (development placeholder, not a real credential):
#   email:    admin@employeeos.local
#   password: ChangeMe123
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@employeeos.local",
  "password": "ChangeMe123"
}

### Login - wrong password -> 401 INVALID_CREDENTIALS
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@employeeos.local",
  "password": "wrong-password-1"
}

### Login - unknown email -> 401 INVALID_CREDENTIALS
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "nobody@example.com",
  "password": "whatever123"
}

### Login - validation error (missing password) -> 400 VALIDATION_ERROR
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@employeeos.local"
}
