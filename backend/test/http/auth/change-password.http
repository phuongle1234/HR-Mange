@baseUrl = http://localhost:3000/api
@access_token = REPLACE_WITH_TOKEN_FROM_LOGIN_RESPONSE

### Change password - success
POST {{baseUrl}}/auth/change-password
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "currentPassword": "ChangeMe123",
  "newPassword": "NewPass456",
  "confirmNewPassword": "NewPass456"
}

### Change password - wrong current password -> 400 CURRENT_PASSWORD_INVALID
POST {{baseUrl}}/auth/change-password
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "currentPassword": "totally-wrong",
  "newPassword": "NewPass456",
  "confirmNewPassword": "NewPass456"
}

### Change password - fails policy (no digit) -> 400 PASSWORD_POLICY_FAILED
POST {{baseUrl}}/auth/change-password
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "currentPassword": "ChangeMe123",
  "newPassword": "onlyletters",
  "confirmNewPassword": "onlyletters"
}

### Change password - confirmation mismatch -> 400 VALIDATION_ERROR
POST {{baseUrl}}/auth/change-password
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "currentPassword": "ChangeMe123",
  "newPassword": "NewPass456",
  "confirmNewPassword": "Mismatch789"
}

### Change password - missing token -> 401 UNAUTHORIZED
POST {{baseUrl}}/auth/change-password
Content-Type: application/json

{
  "currentPassword": "ChangeMe123",
  "newPassword": "NewPass456",
  "confirmNewPassword": "NewPass456"
}
