@baseUrl = http://localhost:3000/api

### Forgot password - registered email -> always the same generic 200 message
POST {{baseUrl}}/auth/forgot-password
Content-Type: application/json

{
  "email": "admin@employeeos.local"
}

### Forgot password - unregistered email -> identical generic 200 message (never reveals existence)
POST {{baseUrl}}/auth/forgot-password
Content-Type: application/json

{
  "email": "nobody@example.com"
}

### Forgot password - invalid email format -> 400 VALIDATION_ERROR
POST {{baseUrl}}/auth/forgot-password
Content-Type: application/json

{
  "email": "not-an-email"
}
