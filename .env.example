NODE_ENV=development
APP_PORT=3000
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/employee_management
JWT_ACCESS_SECRET=change_me
JWT_REFRESH_SECRET=change_me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
LOG_RETENTION_DAYS=10

# infra/docker-compose.yml — local development Docker environment
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=employee_management
POSTGRES_PORT=5432
PGADMIN_DEFAULT_EMAIL=admin@employeeos.local
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050
BACKEND_DEBUG_PORT=9229
FRONTEND_PORT=5173
