NODE_ENV=development
APP_PORT=3000
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/employee_management
# RSA key pair, PEM format with literal \n newline escapes (single-line values)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_REFRESH_SECRET=change_me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Local dev: Mailpit (SMTP 1025 / web UI 8025). Production: swap to MAIL_PROVIDER=mailjet + MAILJET_API_KEY/MAILJET_SECRET_KEY (not yet implemented).
MAIL_PROVIDER=smtp
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@local.test
LOG_RETENTION_DAYS=10

# infra/docker-compose.yml — local development Docker environment
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=employee_management
POSTGRES_PORT=5432
PGADMIN_DEFAULT_EMAIL=admin@employeeos.local
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050
BACKEND_DEBUG_PORT=9229
FRONTEND_PORT=5173
