# Development image for the React/Vite frontend.
# Source is bind-mounted at runtime (see infra/docker-compose.yml); this build
# only installs dependencies so the dev server can start immediately.
FROM node:20-alpine

WORKDIR /app

COPY package*.json ./
RUN npm ci

EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]
